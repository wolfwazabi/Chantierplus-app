rules_version = '2';

// =============================================================================
// Règles Cloud Storage — fichiers de chantier
//
// Chemin : chantiers/{companyId}/{chantierId}/{type}/{fichier}
//   type ∈ photos | chantier_travaux | chantier_materiel | chantier_extras :
//          images, admin et
//          contremaître ;
//   type == documents : plans, devis, etc. Lecture admin et contremaître,
//          dépôt et suppression par les admins (dont le super-admin).
//
// L'appartenance à la compagnie est vérifiée dans Firestore : session écrite
// par le serveur + employé existant de la compagnie avec le bon rôle.
//
// LIMITE DE FIREBASE : une évaluation de règles Storage peut lire AU PLUS DEUX
// documents Firestore distincts ; au-delà, l'accès est refusé en production.
// L'émulateur n'applique PAS cette limite : tout passe aux tests et tout est
// refusé une fois déployé. D'où les deux seuls documents lus ici
// (sessions/{uid}, employees/{id}) et le test tests/rules/storage_limite.unit.test.mjs
// qui échoue si on en ajoute un troisième. Ne sont donc PAS vérifiés ici :
//  - le statut de la compagnie : seule une compagnie approuvée peut ouvrir une
//    session (connexionEmploye) et aucune fonction ne retire l'approbation ;
//  - l'existence du chantier : le chemin est déjà limité à la compagnie de la
//    session, un chantier inexistant ne donne accès à rien d'une autre compagnie.
//
// Note : une URL obtenue par getDownloadURL() contient un jeton d'accès qui
// contourne ces règles en lecture. Ne jamais exposer ces URL hors compagnie.
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function employeDe(companyId, roles) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && firestore.exists(/databases/(default)/documents/sessions/$(request.auth.uid))
        && sessionValide(firestore.get(/databases/(default)/documents/sessions/$(request.auth.uid)).data,
                         companyId, roles);
    }

    function sessionValide(s, companyId, roles) {
      return s.companyId == companyId
        && firestore.exists(/databases/(default)/documents/employees/$(s.employeeId))
        && firestore.get(/databases/(default)/documents/employees/$(s.employeeId)).data.companyId == companyId
        && firestore.get(/databases/(default)/documents/employees/$(s.employeeId)).data.role in roles;
    }

    // Admin ou contremaître.
    function gestionnaireDe(companyId) {
      return employeDe(companyId, ['admin', 'plus']);
    }

    function adminDe(companyId) {
      return employeDe(companyId, ['admin']);
    }

    // ------------------------------------------------ Photos (travaux, matériel)

    match /chantiers/{companyId}/{chantierId}/{type}/{fichier} {
      allow read, delete: if type in ['photos', 'chantier_travaux', 'chantier_materiel', 'chantier_extras']
        && gestionnaireDe(companyId);

      // Création seulement. Dans Storage, réécrire un objet existant passe par
      // « create » (update ne couvre que les métadonnées) : resource == null
      // empêche l'écrasement.
      allow create: if resource == null
        && type in ['photos', 'chantier_travaux', 'chantier_materiel', 'chantier_extras']
        && gestionnaireDe(companyId)
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic)');

      allow update: if false;
    }

    // ------------------------------------------------------------- Documents

    // Formats de bureau, images et plans courants. Refusés volontairement :
    // HTML, SVG, XML, JavaScript et exécutables, qui pourraient servir à
    // l'hameçonnage ou à diffuser un logiciel malveillant depuis le lien.
    function extensionPermise(nom) {
      return nom.lower().matches(
        '.+[.](pdf|doc|docx|xls|xlsx|xlsm|ppt|pptx|odt|ods|odp|rtf|txt|csv'
        + '|jpg|jpeg|png|webp|heic|heif|gif|tif|tiff|bmp'
        + '|dwg|dxf|dwf|ifc|rvt|skp|zip)');
    }

    // Liste exacte (paramètres « ; charset=… » tolérés). Ne pas chercher
    // « xml » partout : les formats Office s'appellent vnd.openxmlformats-….
    function typeDangereux(contentType) {
      return contentType.lower().matches(
        '(text/html|application/xhtml[+]xml|image/svg[+]xml|text/xml|application/xml'
        + '|text/javascript|application/javascript|application/x-javascript|application/ecmascript'
        + '|application/x-msdownload|application/x-msdos-program|application/x-msi'
        + '|application/x-sh|application/x-executable|application/vnd[.]microsoft[.]portable-executable)'
        + '( *;.*)?');
    }

    match /chantiers/{companyId}/{chantierId}/documents/{fichier} {
      allow read: if gestionnaireDe(companyId);

      allow create: if resource == null
        && adminDe(companyId)
        && extensionPermise(fichier)
        && !typeDangereux(request.resource.contentType)
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024;

      allow update: if false;
      allow delete: if adminDe(companyId);
    }

    // Tout le reste est refusé.
    match /{tout=**} {
      allow read, write: if false;
    }
  }
}
