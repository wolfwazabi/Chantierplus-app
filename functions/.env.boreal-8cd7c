# Paramètres de production (non secrets). Les secrets sont dans Secret Manager
# (PIN_PEPPER, RESEND_API_KEY).

# true : refuser tout appel sans attestation App Check (après avoir enregistré
# les applications Android, iOS et web dans la console App Check).
APP_CHECK_OBLIGATOIRE=false

# Adresse d'expédition, sur le domaine vérifié chez Resend (send.chantierplus.app).
COURRIEL_EXPEDITEUR="Chantier+ <noreply@send.chantierplus.app>"

# Page de création du NIP (lien d'invitation envoyé aux nouveaux employés).
URL_CREATION_NIP=https://chantierplus.app/inscription

# Assistant de charpente : adresse de l API et modèle (Claude Haiku 4.5). La clé est dans Secret Manager (ANTHROPIC_API_KEY).
URL_API_ANTHROPIC=https://api.anthropic.com/v1/messages
MODELE_ASSISTANT=claude-haiku-4-5-20251001
