rules_version = '2';

// =============================================================================
// Règles Firestore — application de gestion de chantier (multi-compagnies)
//
// Modèle d'identité :
//  - Employé : compte Firebase anonyme + document sessions/{uid} écrit
//    UNIQUEMENT par la Cloud Function connexionEmploye (Admin SDK). La session
//    n'est valide que si l'employé existe encore, appartient toujours à la même
//    compagnie et que la compagnie est approuvée : une suppression d'employé,
//    un changement de rôle ou un refus de compagnie prend effet immédiatement.
//  - Proprio de l'app (vous) : UN SEUL compte pour toute l'app, la fiche
//    employé désignée dans config/proprio_app (écrit à la main dans la
//    console), connectée par courriel + NIP. Gère les compagnies inscrites.
//  - Particulier : compte courriel/mot de passe, données sous son uid.
//
// Rôles dans une compagnie (codes stockés → noms affichés) :
//  - admin + estProprietaire → « Super-admin » (propriétaire de la compagnie,
//    ne peut être ni rétrogradé ni retiré) ;
//  - admin → « Admin » (personnel de bureau, gestion complète) ;
//  - plus → « Contremaître » (chefs de chantier : photos, travaux, matériel) ;
//  - employe → « Employé » (feuille de temps seulement).
//
// Rappel : les règles ne filtrent pas les requêtes. Toute requête client DOIT
// contenir where('companyId', isEqualTo: ...) sinon elle est refusée en bloc.
//
// Coût : sessions + employees + companies (+ chantiers) = 4 documents au
// maximum par requête ; les get()/exists() d'un même chemin sont mis en cache
// durant une évaluation et ne comptent qu'une fois.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- Identité

    function estAuth() {
      return request.auth != null;
    }

    function fournisseur() {
      return request.auth.token.firebase.sign_in_provider;
    }

    function estIndividu() {
      return estAuth() && fournisseur() == 'password';
    }

    function cheminSession() {
      return /databases/$(database)/documents/sessions/$(request.auth.uid);
    }

    function cheminEmploye(id) {
      return /databases/$(database)/documents/employees/$(id);
    }

    function cheminCompagnie(id) {
      return /databases/$(database)/documents/companies/$(id);
    }

    function session() {
      return get(cheminSession()).data;
    }

    function moi() {
      return get(cheminEmploye(session().employeeId)).data;
    }

    function maCompagnie() {
      return session().companyId;
    }

    // Vérifié en premier par toutes les règles employé ; grâce au court-circuit
    // de &&, session()/moi() ne sont jamais évalués sur un document absent.
    function estEmployeActif() {
      return estAuth()
        && fournisseur() == 'anonymous'
        && exists(cheminSession())
        && sessionEstValide(session());
    }

    // expireLe : présent seulement sur les sessions de l'espace web (canal « web »,
    // 12 h). Les sessions de l'application mobile n'en ont pas et restent valides.
    function sessionEstValide(s) {
      return s.employeeId is string
        && s.companyId is string
        && (!('expireLe' in s) || s.expireLe > request.time)
        && exists(cheminEmploye(s.employeeId))
        && get(cheminEmploye(s.employeeId)).data.companyId == s.companyId
        // Ancien employé (accès retiré, fiche conservée un temps) : plus aucun accès.
        && get(cheminEmploye(s.employeeId)).data.get('actif', true) != false
        && get(cheminCompagnie(s.companyId)).data.statut == 'approuvee';
    }

    function membreDe(companyId) {
      return estEmployeActif() && maCompagnie() == companyId;
    }

    function adminDe(companyId) {
      return membreDe(companyId) && moi().role == 'admin';
    }

    // Admin ou contremaître.
    function gestionnaireDe(companyId) {
      return membreDe(companyId) && moi().role in ['admin', 'plus'];
    }

    // Un seul Proprio pour toute l'app : la fiche employé désignée dans
    // config/proprio_app { employeeId } (écrit à la main dans la console).
    function cheminProprioApp() {
      return /databases/$(database)/documents/config/proprio_app;
    }

    function estLeProprioApp(employeeId) {
      return exists(cheminProprioApp())
        && get(cheminProprioApp()).data.employeeId == employeeId;
    }

    function estProprioApp() {
      return estEmployeActif() && estLeProprioApp(session().employeeId);
    }

    // ------------------------------------------------------------- Validation

    function texte(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function texteOptionnel(data, champ, max) {
      return !data.keys().hasAny([champ]) || texte(data[champ], 0, max);
    }

    function champsPermis(data, permis) {
      return data.keys().hasOnly(permis);
    }

    function champsModifiesPermis(permis) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(permis);
    }

    function urlStorage(v) {
      return v is string
        && v.size() <= 2048
        && v.matches('https://firebasestorage[.]googleapis[.]com/.*');
    }

    function chantierDe(chantierId, companyId) {
      return chantierId is string
        && exists(/databases/$(database)/documents/chantiers/$(chantierId))
        && get(/databases/$(database)/documents/chantiers/$(chantierId)).data.companyId == companyId;
    }

    // ------------------------------------------------ Collections serveur seul

    match /compteurs/{doc=**} {
      allow read, write: if false;
    }

    match /limites_connexion/{doc=**} {
      allow read, write: if false;
    }

    match /companies_prive/{doc=**} {
      allow read, write: if false;
    }

    match /reinitialisations_nip/{doc=**} {
      allow read, write: if false;
    }

    // Liens de création du NIP (empreintes des jetons) : serveur seulement.
    match /invitations_nip/{doc=**} {
      allow read, write: if false;
    }

    // Codes de connexion de l'espace web (empreinte du code, essais) : serveur seulement.
    match /connexions_web/{doc=**} {
      allow read, write: if false;
    }

    // NIP hachés des employés : serveur seulement (jamais lisibles par les admins).
    match /employees_prive/{doc=**} {
      allow read, write: if false;
    }

    // Appareils de confiance de l'espace web (empreinte du jeton, dates) : serveur seulement.
    match /appareils_web/{doc=**} {
      allow read, write: if false;
    }

    match /config/{doc=**} {
      allow read, write: if false;
    }

    // Trace des compagnies supprimées (numéro, nom, date, décompte) : serveur seulement.
    match /journal_suppressions/{doc=**} {
      allow read, write: if false;
    }

    // ----------------------------------------------------------------- Sessions

    match /sessions/{uid} {
      allow get: if estAuth() && request.auth.uid == uid;
      allow delete: if estAuth() && request.auth.uid == uid;
      // Création/modification : jamais depuis le client (sinon usurpation).
      allow list, create, update: if false;
    }

    // --------------------------------------------------------------- Compagnies

    match /companies/{companyId} {
      allow get: if membreDe(companyId) || estProprioApp();
      allow list: if estProprioApp();

      // Couleur de l'application : les admins (dont le super-admin) de la
      // compagnie peuvent modifier ce seul champ, au format « #RRGGBB ».
      // Réglages de la compagnie : les admins (dont le super-admin) peuvent
      // modifier la couleur de l'application et les règles de paie, et rien
      // d'autre (statut, numéro… : Cloud Functions seulement).
      allow update: if adminDe(companyId)
        && champsModifiesPermis(['couleurTheme', 'reglesPaie'])
        && (!request.resource.data.keys().hasAny(['couleurTheme'])
            || (request.resource.data.couleurTheme is string
                && request.resource.data.couleurTheme.matches('#[0-9A-F]{6}')))
        && (!request.resource.data.keys().hasAny(['reglesPaie'])
            || reglesPaieValides(request.resource.data.reglesPaie));

      // Création, statut, numéro… : Cloud Functions seulement
      // (inscrireCompagnie / approuverCompagnie).
      allow create, delete: if false;
    }

    // ----------------------------------------------------------------- Employés

    // Aucune écriture client : les Cloud Functions enregistrerEmploye et
    // supprimerEmploye valident tout (NIP haché, courriel unique, seul le
    // super-admin de la compagnie gère les admins, super-admin protégé).
    match /employees/{employeeId} {
      allow get: if membreDe(resource.data.companyId)
        && (employeeId == session().employeeId || moi().role == 'admin');
      allow list: if adminDe(resource.data.companyId);
      allow write: if false;
    }

    // -------------------------------------------------------------- Particuliers

    match /individus/{uid} {
      allow get: if estIndividu() && request.auth.uid == uid;
      // Courriel identique à celui du jeton (l'app enregistre user.email).
      allow create, update: if estIndividu()
        && request.auth.uid == uid
        && champsPermis(request.resource.data, ['nom', 'email'])
        && texte(request.resource.data.nom, 1, 100)
        && request.resource.data.email == request.auth.token.email;
      allow list, delete: if false;
    }

    // Règles de paie (pauses, voyagement) : mêmes bornes que ReglesPaie.
    function entierEntre(v, min, max) {
      return v is int && v >= min && v <= max;
    }

    function reglesPaieValides(r) {
      return r is map
        && r.keys().hasOnly(['pauseMatinMinutes', 'pauseMatinPayee', 'dinerMinutes',
                             'dinerPaye', 'voyagementActif', 'voyagementSeuilMinutes',
                             'voyagementPourcentage'])
        && r.keys().hasAll(['pauseMatinMinutes', 'pauseMatinPayee', 'dinerMinutes',
                            'dinerPaye', 'voyagementActif', 'voyagementSeuilMinutes',
                            'voyagementPourcentage'])
        && entierEntre(r.pauseMatinMinutes, 0, 120)
        && r.pauseMatinPayee is bool
        && entierEntre(r.dinerMinutes, 0, 120)
        && r.dinerPaye is bool
        && r.voyagementActif is bool
        && entierEntre(r.voyagementSeuilMinutes, 0, 600)
        && entierEntre(r.voyagementPourcentage, 0, 100);
    }

    // ---------------------------------------------------------------- Chantiers

    // Lecture par tous les membres : la feuille de temps a besoin de la liste.
    match /chantiers/{chantierId} {
      allow read: if membreDe(resource.data.companyId);

      // « _general » est réservé à la liste de matériel Général (pas un chantier).
      allow create: if adminDe(request.resource.data.companyId)
        && chantierId != '_general'
        && champsPermis(request.resource.data, ['companyId', 'nom', 'adresse'])
        && texte(request.resource.data.nom, 1, 200)
        && texteOptionnel(request.resource.data, 'adresse', 300);

      // « archive » : un chantier retiré de la liste garde ses photos, documents
      // et heures. Jamais supprimé : photos et documents resteraient orphelins.
      allow update: if adminDe(resource.data.companyId)
        && champsModifiesPermis(['nom', 'adresse', 'archive'])
        && texte(request.resource.data.nom, 1, 200)
        && texteOptionnel(request.resource.data, 'adresse', 300)
        && (!request.resource.data.keys().hasAny(['archive'])
            || request.resource.data.archive is bool);

      allow delete: if false;
    }

    // ------------------------------------------ Photos (admin et contremaître)

    match /chantier_photos/{photoId} {
      allow read: if gestionnaireDe(resource.data.companyId);

      allow create: if gestionnaireDe(request.resource.data.companyId)
        && champsPermis(request.resource.data,
             ['companyId', 'chantierId', 'url', 'cheminStorage', 'dateAjout',
              'ajoutePar', 'ajouteParNom'])
        && acteurOptionnelValide(request.resource.data)
        && chantierDe(request.resource.data.chantierId, request.resource.data.companyId)
        && urlStorage(request.resource.data.url)
        && request.resource.data.cheminStorage is string
        && request.resource.data.cheminStorage.matches(
             'chantiers/' + request.resource.data.companyId + '/'
             + request.resource.data.chantierId + '/photos/[^/]{1,200}')
        && request.resource.data.dateAjout == request.time;

      allow update: if false;
      allow delete: if gestionnaireDe(resource.data.companyId);
    }

    // ------------------------------- Travaux / Matériel (admin et contremaître)

    // Photos d'une entrée : photoUrl (la première) et photoUrls (toutes, 6 au plus).
    // photoUrls va avec photoUrl : la première des deux listes est la même.
    function photosEntreeValides(d) {
      return (!d.keys().hasAny(['photoUrl']) || urlStorage(d.photoUrl))
        && (!d.keys().hasAny(['photoUrls'])
            || (d.photoUrls is list
                && d.photoUrls.size() >= 1 && d.photoUrls.size() <= 6
                && d.keys().hasAny(['photoUrl'])
                && d.photoUrl == d.photoUrls[0]
                && urlStorage(d.photoUrls[0])
                && (d.photoUrls.size() < 2 || urlStorage(d.photoUrls[1]))
                && (d.photoUrls.size() < 3 || urlStorage(d.photoUrls[2]))
                && (d.photoUrls.size() < 4 || urlStorage(d.photoUrls[3]))
                && (d.photoUrls.size() < 5 || urlStorage(d.photoUrls[4]))
                && (d.photoUrls.size() < 6 || urlStorage(d.photoUrls[5]))));
    }

    // Champs communs à toute nouvelle entrée de travaux ou de matériel.
    function entreeCommuneValide(d) {
      return texte(d.texte, 1, 2000)
        && d.complete == false
        && d.dateAjout == request.time
        && photosEntreeValides(d)
        && texteOptionnel(d, 'quantite', 100);
    }

    // Qui a fait le geste (fil « Activité » de l'admin) : facultatif, pour les anciennes
    // versions de l'application ; s'il est là, c'est bien l'employé connecté.
    function acteurOptionnelValide(d) {
      return !d.keys().hasAny(['ajoutePar', 'ajouteParNom'])
        || (d.keys().hasAll(['ajoutePar', 'ajouteParNom'])
            && d.ajoutePar == session().employeeId
            && d.ajouteParNom == moi().nom);
    }

    function entreeValideCreation(d) {
      return champsPermis(d, ['companyId', 'chantierId', 'texte', 'complete',
                              'dateAjout', 'photoUrl', 'photoUrls', 'quantite',
                              'ajoutePar', 'ajouteParNom'])
        && acteurOptionnelValide(d)
        && chantierDe(d.chantierId, d.companyId)
        && entreeCommuneValide(d);
    }

    // « _general » : liste de matériel « Général » (remorque, sans chantier). Ce
    // n'est pas un chantier : il n'existe pas dans « chantiers », donc il ne se
    // choisit jamais pour les heures. Matériel seulement. Chaque entrée porte son
    // auteur (contremaître ou admin) : la liste se sépare par personne et un admin
    // voit ce qui a changé depuis sa dernière visite.
    function entreeGeneralValideCreation(d) {
      return champsPermis(d, ['companyId', 'chantierId', 'texte', 'complete',
                              'dateAjout', 'photoUrl', 'photoUrls', 'quantite',
                              'ajoutePar', 'ajouteParNom'])
        && d.chantierId == '_general'
        && d.ajoutePar == session().employeeId
        && d.ajouteParNom == moi().nom
        && entreeCommuneValide(d);
    }

    function entreeValideModification(d) {
      return champsModifiesPermis(['texte', 'quantite', 'photoUrl', 'photoUrls', 'complete',
                                   'dateComplete', 'dateModif', 'modifiePar',
                                   'transfere', 'transfereParNom'])
        && texte(d.texte, 1, 2000)
        && d.complete is bool
        && photosEntreeValides(d)
        && texteOptionnel(d, 'quantite', 100)
        // dateComplete : horodatage serveur quand on complète, absent sinon.
        && (d.complete == true
              ? (!d.diff(resource.data).affectedKeys().hasAny(['dateComplete'])
                 || d.dateComplete == request.time)
              : !d.keys().hasAny(['dateComplete']))
        // dateModif + modifiePar : seulement pour Général (qui a changé quoi, quand).
        && (!d.diff(resource.data).affectedKeys().hasAny(['dateModif', 'modifiePar'])
            || (resource.data.chantierId == '_general'
                && d.dateModif == request.time
                && d.modifiePar == session().employeeId))
        // transfere + transfereParNom : un admin seulement, pour Général. Posés ensemble
        // (transfere vrai, nom de l'admin) quand il transfère la demande à la Liste
        // d'achats ; retirés ensemble quand l'article en est retiré.
        && (!d.diff(resource.data).affectedKeys().hasAny(['transfere', 'transfereParNom'])
            || (moi().role == 'admin'
                && resource.data.chantierId == '_general'
                && ((d.keys().hasAll(['transfere', 'transfereParNom'])
                     && d.transfere == true
                     && d.transfereParNom == moi().nom)
                    || !d.keys().hasAny(['transfere', 'transfereParNom']))));
    }

    match /chantier_travaux/{entreeId} {
      allow read: if gestionnaireDe(resource.data.companyId);
      allow create: if gestionnaireDe(request.resource.data.companyId)
        && entreeValideCreation(request.resource.data);
      allow update: if gestionnaireDe(resource.data.companyId)
        && entreeValideModification(request.resource.data);
      allow delete: if gestionnaireDe(resource.data.companyId);
    }

    // Général : un contremaître ne voit, ne modifie et ne supprime QUE ses propres
    // demandes (les autres listes lui restent fermées) ; un admin voit tout. Pour un
    // chantier ordinaire, rien ne change. Un contremaître doit donc demander sa liste
    // avec where('ajoutePar', isEqualTo: son identifiant).
    function entreeAccessible(r) {
      return r.chantierId != '_general'
        || moi().role == 'admin'
        || r.ajoutePar == session().employeeId;
    }

    // Une demande transférée à la Liste d'achats reste visible pour son auteur, mais
    // seul un admin la modifie, la marque faite ou la supprime.
    function entreeModifiable(r) {
      return entreeAccessible(r)
        && (moi().role == 'admin' || r.get('transfere', false) != true);
    }

    match /chantier_materiel/{entreeId} {
      allow read: if gestionnaireDe(resource.data.companyId)
        && entreeAccessible(resource.data);
      allow create: if gestionnaireDe(request.resource.data.companyId)
        && (entreeValideCreation(request.resource.data)
            || entreeGeneralValideCreation(request.resource.data));
      allow update: if gestionnaireDe(resource.data.companyId)
        && entreeModifiable(resource.data)
        && entreeValideModification(request.resource.data);
      allow delete: if gestionnaireDe(resource.data.companyId)
        && entreeModifiable(resource.data);
    }

    // Fil « Activité » (Admin) : jusqu'à quelle date cet admin a tout vu. Un document par
    // admin, lisible et modifiable par lui seul. La date vient des événements eux-mêmes :
    // jamais dans le futur (on ne peut pas masquer ce qui n'est pas encore arrivé).
    match /activite_vus/{employeId} {
      allow read: if estEmployeActif() && moi().role == 'admin'
        && employeId == session().employeeId;

      allow create, update: if estEmployeActif() && moi().role == 'admin'
        && employeId == session().employeeId
        && champsPermis(request.resource.data, ['companyId', 'vuJusqua'])
        && request.resource.data.companyId == maCompagnie()
        && request.resource.data.vuJusqua is timestamp
        && request.resource.data.vuJusqua <= request.time;

      allow delete: if false;
    }

    // Matériel Général : ce que chaque admin a déjà vu, pour la pastille « changement
    // non vu » (un document par admin, lisible et modifiable par lui seul).
    // vus : { idDeLAuteur: horodatage de la dernière visite }.
    // nonLus : { idDeLaDemande: true } demandes que l'admin a marquées « non lu ».
    match /materiel_general_vus/{employeId} {
      allow read: if estEmployeActif() && moi().role == 'admin'
        && employeId == session().employeeId;

      allow create, update: if estEmployeActif() && moi().role == 'admin'
        && employeId == session().employeeId
        && champsPermis(request.resource.data, ['companyId', 'vus', 'nonLus'])
        && request.resource.data.companyId == maCompagnie()
        && (!request.resource.data.keys().hasAny(['vus'])
            || (request.resource.data.vus is map
                && request.resource.data.vus.size() <= 200))
        && (!request.resource.data.keys().hasAny(['nonLus'])
            || (request.resource.data.nonLus is map
                && request.resource.data.nonLus.size() <= 500));

      allow delete: if false;
    }

    // ------------------------------------------------------- Liste d'achats (admin)
    // Demandes de matériel Général transférées par un admin pour être achetées.
    // Admin seulement (lecture, création, « acheté », suppression). Le texte, la
    // quantité et la photo viennent de la demande d'origine ; qui l'a demandée et
    // qui l'a transférée sont conservés.

    match /liste_achats/{articleId} {
      allow read: if adminDe(resource.data.companyId);

      allow create: if adminDe(request.resource.data.companyId)
        && champsPermis(request.resource.data,
             ['companyId', 'texte', 'quantite', 'photoUrl', 'photoUrls', 'demandeParId',
              'demandeParNom', 'transfereParId', 'transfereParNom', 'origine',
              'origineId', 'complete', 'dateAjout'])
        && (!request.resource.data.keys().hasAny(['origineId'])
            || (request.resource.data.origineId is string
                && request.resource.data.origineId.size() >= 1
                && request.resource.data.origineId.size() <= 128))
        && texte(request.resource.data.texte, 1, 2000)
        && texteOptionnel(request.resource.data, 'quantite', 100)
        && photosEntreeValides(request.resource.data)
        && request.resource.data.demandeParId is string
        && request.resource.data.demandeParId.size() <= 128
        && texte(request.resource.data.demandeParNom, 0, 200)
        && request.resource.data.transfereParId == session().employeeId
        && request.resource.data.transfereParNom == moi().nom
        && request.resource.data.origine == 'general'
        && request.resource.data.complete == false
        && request.resource.data.dateAjout == request.time;

      allow update: if adminDe(resource.data.companyId)
        && champsModifiesPermis(['complete', 'dateComplete'])
        && request.resource.data.complete is bool
        && (request.resource.data.complete == true
              ? (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dateComplete'])
                 || request.resource.data.dateComplete == request.time)
              : !request.resource.data.keys().hasAny(['dateComplete']));

      allow delete: if adminDe(resource.data.companyId);
    }

    // ---------------------------------------------------------------- Extras
    // Travaux supplémentaires d'un chantier : description, main-d'œuvre et temps
    // (texte libre : « 3 gars, 1 compagnon, 1 apprenti — 4 h »), date et photo
    // facultative. Admin et contremaître les saisissent et les modifient ; seul
    // un admin les supprime (ils servent à facturer).

    function datePropre(v) {
      return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    // Photo facultative : l'URL et le chemin vont ensemble, dans le dossier
    // « chantier_extras » du chantier.
    function photoExtraValide(d, companyId, chantierId) {
      return d.keys().hasAny(['photoUrl']) == d.keys().hasAny(['cheminPhoto'])
        && (!d.keys().hasAny(['photoUrl'])
            || (urlStorage(d.photoUrl)
                && d.cheminPhoto is string
                && d.cheminPhoto.matches('chantiers/' + companyId + '/' + chantierId
                                         + '/chantier_extras/[^/]{1,250}')));
    }

    function cheminExtraValide(c, companyId, chantierId) {
      return c is string
        && c.matches('chantiers/' + companyId + '/' + chantierId
                     + '/chantier_extras/[^/]{1,250}');
    }

    // Plusieurs photos (6 au plus) : photoUrls et cheminsPhotos vont ensemble, de
    // même taille ; la première de chaque liste est photoUrl / cheminPhoto.
    function photoExtraNumero(d, i, companyId, chantierId) {
      return d.photoUrls.size() <= i
        || (urlStorage(d.photoUrls[i])
            && cheminExtraValide(d.cheminsPhotos[i], companyId, chantierId));
    }

    function photosExtraMultiplesValides(d, companyId, chantierId) {
      return d.keys().hasAny(['photoUrls']) == d.keys().hasAny(['cheminsPhotos'])
        && (!d.keys().hasAny(['photoUrls'])
            || (d.photoUrls is list && d.cheminsPhotos is list
                && d.photoUrls.size() >= 1 && d.photoUrls.size() <= 6
                && d.cheminsPhotos.size() == d.photoUrls.size()
                && d.keys().hasAny(['photoUrl', 'cheminPhoto'])
                && d.photoUrl == d.photoUrls[0]
                && d.cheminPhoto == d.cheminsPhotos[0]
                && photoExtraNumero(d, 0, companyId, chantierId)
                && photoExtraNumero(d, 1, companyId, chantierId)
                && photoExtraNumero(d, 2, companyId, chantierId)
                && photoExtraNumero(d, 3, companyId, chantierId)
                && photoExtraNumero(d, 4, companyId, chantierId)
                && photoExtraNumero(d, 5, companyId, chantierId)));
    }

    function contenuExtraValide(d, companyId, chantierId) {
      return texte(d.description, 1, 2000)
        && texte(d.mainOeuvre, 1, 300)
        && datePropre(d.dateTravaux)
        && photoExtraValide(d, companyId, chantierId)
        && photosExtraMultiplesValides(d, companyId, chantierId);
    }

    match /chantier_extras/{extraId} {
      allow read: if gestionnaireDe(resource.data.companyId);

      allow create: if gestionnaireDe(request.resource.data.companyId)
        && champsPermis(request.resource.data,
             ['companyId', 'chantierId', 'description', 'mainOeuvre',
              'dateTravaux', 'photoUrl', 'cheminPhoto', 'photoUrls', 'cheminsPhotos',
              'ajoutePar', 'ajouteParNom', 'dateAjout'])
        && chantierDe(request.resource.data.chantierId, request.resource.data.companyId)
        && contenuExtraValide(request.resource.data, request.resource.data.companyId,
                              request.resource.data.chantierId)
        && request.resource.data.ajoutePar == session().employeeId
        && request.resource.data.ajouteParNom == moi().nom
        && request.resource.data.dateAjout == request.time;

      allow update: if gestionnaireDe(resource.data.companyId)
        && champsModifiesPermis(['description', 'mainOeuvre', 'dateTravaux',
                                 'photoUrl', 'cheminPhoto', 'photoUrls', 'cheminsPhotos'])
        && contenuExtraValide(request.resource.data, resource.data.companyId,
                              resource.data.chantierId);

      allow delete: if adminDe(resource.data.companyId);
    }

    // -------------------------------------------------- Commandes de matériaux
    // Liste d'achat du calcul de charpente, enregistrée pour un chantier :
    // lignes (tableau), projet (texte JSON pour rouvrir le calcul), statut et
    // notes. Admin et contremaître les créent, les suivent (brouillon →
    // commandée → reçue) et les consultent ; les lignes ne changent plus une
    // fois enregistrées. Un admin supprime n'importe quelle commande, un
    // contremaître seulement un brouillon.

    function commandeValide(d) {
      return texte(d.nom, 1, 200)
        && d.lignes is list && d.lignes.size() >= 1 && d.lignes.size() <= 300
        && (!d.keys().hasAny(['projet']) || texte(d.projet, 0, 150000))
        && d.statut in ['brouillon', 'commandee', 'recue']
        && texteOptionnel(d, 'notes', 2000)
        && texteOptionnel(d, 'fournisseur', 200);
    }

    match /chantier_commandes/{commandeId} {
      allow read: if gestionnaireDe(resource.data.companyId);

      allow create: if gestionnaireDe(request.resource.data.companyId)
        && champsPermis(request.resource.data,
             ['companyId', 'chantierId', 'nom', 'lignes', 'projet', 'statut',
              'notes', 'fournisseur', 'ajoutePar', 'ajouteParNom', 'dateAjout'])
        && chantierDe(request.resource.data.chantierId, request.resource.data.companyId)
        && commandeValide(request.resource.data)
        && request.resource.data.statut == 'brouillon'
        && request.resource.data.ajoutePar == session().employeeId
        && request.resource.data.ajouteParNom == moi().nom
        && request.resource.data.dateAjout == request.time;

      allow update: if gestionnaireDe(resource.data.companyId)
        && champsModifiesPermis(['nom', 'statut', 'notes', 'fournisseur', 'dateCommande'])
        && commandeValide(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dateCommande'])
            || request.resource.data.dateCommande == request.time);

      allow delete: if adminDe(resource.data.companyId)
        || (gestionnaireDe(resource.data.companyId) && resource.data.statut == 'brouillon');
    }

    // ------------------------------------------------ Documents de chantier
    // Plans, devis, photos, etc. Consultés par les admins et contremaîtres ;
    // déposés et supprimés par les admins (dont le super-admin) seulement.
    // Le fichier lui-même est dans Storage (voir storage.rules).

    match /chantier_documents/{documentId} {
      allow read: if gestionnaireDe(resource.data.companyId);

      allow create: if adminDe(request.resource.data.companyId)
        && champsPermis(request.resource.data,
             ['companyId', 'chantierId', 'nom', 'cheminStorage', 'url',
              'taille', 'typeMime', 'ajoutePar', 'ajouteParNom', 'dateAjout'])
        && (!request.resource.data.keys().hasAny(['ajouteParNom'])
            || request.resource.data.ajouteParNom == moi().nom)
        && chantierDe(request.resource.data.chantierId, request.resource.data.companyId)
        && texte(request.resource.data.nom, 1, 200)
        && request.resource.data.cheminStorage is string
        && request.resource.data.cheminStorage.matches(
             'chantiers/' + request.resource.data.companyId + '/'
             + request.resource.data.chantierId + '/documents/[^/]{1,250}')
        && urlStorage(request.resource.data.url)
        && request.resource.data.taille is int
        && request.resource.data.taille > 0
        && request.resource.data.taille <= 50 * 1024 * 1024
        && texte(request.resource.data.typeMime, 1, 150)
        && request.resource.data.ajoutePar == session().employeeId
        && request.resource.data.dateAjout == request.time;

      allow update: if false;
      allow delete: if adminDe(resource.data.companyId);
    }

    // ---------------------------------------------------------- Feuilles de temps

    // Identifiant : {employeeId}_{AAAA-MM-JJ} (lundi de la semaine).
    function idFeuille(proprietaireId, lundiDate) {
      return proprietaireId + '_' + lundiDate;
    }

    function contenuFeuilleValide(d, feuilleId) {
      return d.lundiDate is string
        && d.lundiDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && feuilleId == idFeuille(d.employeeId, d.lundiDate)
        && texte(d.employeeNom, 0, 200)
        && d.jours is list
        && d.jours.size() <= 7
        && d.totalHeures is number
        && d.totalHeures >= 0
        && d.totalHeures <= 168
        && d.dateModification == request.time
        && (!d.keys().hasAny(['totalHeuresTravaillees'])
            || (d.totalHeuresTravaillees is number
                && d.totalHeuresTravaillees >= 0 && d.totalHeuresTravaillees <= 168))
        && (!d.keys().hasAny(['totalVoyagementPaye'])
            || (d.totalVoyagementPaye is number
                && d.totalVoyagementPaye >= 0 && d.totalVoyagementPaye <= 168));
    }

    // Feuilles de compagnie : AUCUNE écriture depuis l'app. La Cloud Function
    // enregistrerFeuilleTemps recalcule heures, voyagement et totaux avec les
    // règles de paie de la compagnie, applique le verrouillage et vérifie les
    // chantiers. Seule la feuille personnelle d'un particulier (sans paie,
    // sans compagnie) s'écrit directement.
    function feuilleIndividuValide(d, feuilleId) {
      return champsPermis(d, ['estIndividuel', 'employeeId', 'employeeNom',
                              'lundiDate', 'jours', 'totalHeures', 'dateModification',
                              'totalHeuresTravaillees', 'totalVoyagementPaye'])
        && d.employeeId == request.auth.uid
        && d.estIndividuel == true
        && contenuFeuilleValide(d, feuilleId);
    }

    match /feuilles_temps/{feuilleId} {
      // Lecture de sa propre feuille, y compris inexistante (resource == null).
      allow get: if (estEmployeActif()
                      && feuilleId.matches(session().employeeId + '_[0-9]{4}-[0-9]{2}-[0-9]{2}'))
                 || (estIndividu()
                      && feuilleId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}'));

      // Admin : toutes les feuilles de sa compagnie (requêtes filtrées par companyId).
      allow list: if adminDe(resource.data.companyId);

      allow create, update: if estIndividu()
                            && feuilleIndividuValide(request.resource.data, feuilleId);

      allow delete: if false;
    }

    // ------------------------------------------------- Notifications (admins)

    // Le jeton de notification de l'appareil d'un admin, sous l'uid de sa session : seul cet
    // appareil l'écrit ou l'efface ; le serveur s'en sert pour envoyer (Admin SDK).
    match /appareils_notifications/{uid} {
      allow get: if estAuth() && request.auth.uid == uid;
      allow create, update: if estAuth() && request.auth.uid == uid
        && adminDe(request.resource.data.companyId)
        && request.resource.data.employeeId == session().employeeId
        && champsPermis(request.resource.data,
             ['companyId', 'employeeId', 'jeton', 'plateforme', 'majLe'])
        && texte(request.resource.data.jeton, 1, 4096)
        && request.resource.data.plateforme in ['android', 'ios']
        && request.resource.data.majLe == request.time;
      allow delete: if estAuth() && request.auth.uid == uid;
    }

    // Les catégories que l'admin veut recevoir (absent = toutes) : les siennes seulement.
    function prefNotif(d, champ) {
      return !d.keys().hasAny([champ]) || d[champ] is bool;
    }

    match /preferences_notifications/{employeeId} {
      allow get: if estEmployeActif() && employeeId == session().employeeId;
      allow create, update: if adminDe(request.resource.data.companyId)
        && employeeId == session().employeeId
        && champsPermis(request.resource.data, ['companyId', 'extras', 'travaux', 'materiel',
                                                'heures', 'photos', 'documents'])
        && prefNotif(request.resource.data, 'extras')
        && prefNotif(request.resource.data, 'travaux')
        && prefNotif(request.resource.data, 'materiel')
        && prefNotif(request.resource.data, 'heures')
        && prefNotif(request.resource.data, 'photos')
        && prefNotif(request.resource.data, 'documents');
      allow delete: if false;
    }

    // Tout le reste est refusé par défaut.
  }
}
